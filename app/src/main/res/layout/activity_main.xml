<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.drawify.app.OverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/panel_bg"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/empty_hint"
        android:textColor="@android:color/white"
        android:textSize="16sp" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tiltLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/visibilityButton"
            style="@style/RoundIconButton"
            android:contentDescription="@string/toggle_visibility"
            android:src="@drawable/ic_visibility" />

        <ImageButton
            android:id="@+id/flashButton"
            style="@style/RoundIconButton"
            android:contentDescription="@string/flash"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/lockButton"
            style="@style/RoundIconButton"
            android:contentDescription="@string/lock"
            android:src="@drawable/ic_lock_open" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_bg"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opacity"
                android:textColor="@android:color/white"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/opacitySeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="50" />

            <TextView
                android:id="@+id/opacityValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickButton"
                style="@style/ToolButton"
                android:text="@string/pick"
                app:icon="@drawable/ic_image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/filterButton"
                style="@style/ToolButton"
                android:text="@string/filter_original"
                app:icon="@drawable/ic_brush" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tiltButton"
                style="@style/ToolButton"
                android:text="@string/tilt"
                app:icon="@drawable/ic_tilt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cornersButton"
                style="@style/ToolButton"
                android:text="@string/corners"
                app:icon="@drawable/ic_corners" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/flipButton"
                style="@style/ToolButton"
                android:text="@string/flip"
                app:icon="@drawable/ic_flip" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                style="@style/ToolButton"
                android:text="@string/reset"
                app:icon="@drawable/ic_center" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
